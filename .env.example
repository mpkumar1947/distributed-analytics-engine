# ==============================================================================
# Gradiator Bot — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.
# For Render deployment, set these in the Render Dashboard → Environment.

# Database Configuration (Neon PostgreSQL — use the POOLED connection string)
# Format: postgresql+asyncpg://user:password@ep-xxx-yyy.region.aws.neon.tech/gradedb?sslmode=require
DATABASE_URL="postgresql+asyncpg://user:password@ep-example.us-east-2.aws.neon.tech/gradedb?sslmode=require"

# Redis Configuration (Upstash — use the rediss:// TLS URL)
# Format: rediss://default:TOKEN@endpoint.upstash.io:PORT
REDIS_URL="rediss://default:your-token@us1-example.upstash.io:6379"

# Telegram Bot Credentials
# Get this from @BotFather
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"

# Admin Configuration
# Comma-separated list of Telegram User IDs for admin access
TELEGRAM_ADMIN_IDS=12345678

# Channel for storing plot images (create a private channel, add bot as admin)
TELEGRAM_PLOT_STORAGE_CHANNEL_ID=""

# Webhook Configuration
# On Render, RENDER_EXTERNAL_URL is auto-set — no need for PUBLIC_DOMAIN.
# For local dev, set PUBLIC_DOMAIN manually.
# PUBLIC_DOMAIN="your-domain.com"
WEBHOOK_URL_PATH_PREFIX="/webhook"

# Feature Flags
BOT_STARTUP_MAINTENANCE_MODE="false"